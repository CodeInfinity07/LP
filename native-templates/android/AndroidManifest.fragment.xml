<!--
    Entries to merge into the Cocos Creator-generated AndroidManifest.xml
    via the build-templates mechanism (proj/android-instant/... or
    native/engine/android/app/AndroidManifest.xml depending on the Creator
    version - confirm exact merge point in Phase 0).

    Ported directly from Assets/Plugins/Android/AndroidManifest.xml, the
    Unity project's actual shipped manifest, so this is the same Facebook
    app (same App ID / Client Token / content-provider authority), not a
    placeholder. FBUnity*Activity classes are Unity-SDK-specific and are
    NOT ported - Cocos Creator's native FB integration will use the plain
    Android Facebook SDK's own LoginManager/FacebookActivity instead, so
    only the meta-data and provider entries carry over unchanged, plus one
    activity (FacebookActivity, provided by the SDK itself, not written
    by us) which the SDK's own AAR contributes automatically.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Provided automatically by the com.facebook.android:facebook-login AAR -
         listed here only for visibility, do not declare it again by hand. -->
    <!-- <activity android:name="com.facebook.FacebookActivity" .../> -->

    <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="fb1787730748457941" />
    <meta-data android:name="com.facebook.sdk.ClientToken" android:value="bf296f448fbfc4962475033174a1376e" />

    <!--
      Unity's manifest had both of these hardcoded to "true". Per the port
      plan's recommendation, consider setting AutoLogAppEventsEnabled and
      AdvertiserIDCollectionEnabled to "false" here, since this project only
      uses FB login + profile fetch (no FB Analytics/App Events, no ad
      attribution) - disabling both means no iOS App Tracking Transparency
      prompt is needed either. Left as "true" below to match existing
      behavior exactly; flip to "false" as a deliberate decision, not
      silently.
    -->
    <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="true" />
    <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="true" />

    <provider
        android:name="com.facebook.FacebookContentProvider"
        android:authorities="com.facebook.app.FacebookContentProvider1787730748457941"
        android:exported="true" />
  </application>
</manifest>
